{
  "name": "@boehringer-ingelheim/prettier-config",
  "version": "2.0.0",
  "type": "module",
  "description": "Shared prettier configuration used at Boehringer Ingelheim for code formatting",
  "repository": {
    "type": "git",
    "url": "https://github.com/Boehringer-Ingelheim/prettier-config.git"
  },
  "homepage": "https://github.com/Boehringer-Ingelheim/prettier-config",
  "bugs": {
    "url": "https://github.com/Boehringer-Ingelheim/prettier-config/issues"
  },
  "author": "Boehringer Ingelheim",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "boehringer",
    "boehringer-ingelheim",
    "configuration",
    "prettier",
    "prettierrc",
    "prettier-config"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "husky",
    "release": "semantic-release",
    "repair": "npx --yes rimraf@6 .git/hooks node_modules package-lock.json && npm install",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "prettier-plugin-groovy": "^0.2.1",
    "prettier-plugin-jsdoc": "^1.8.0",
    "prettier-plugin-nginx": "^1.0.3",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-sql": "^0.20.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@types/node": "25.7.0",
    "dotenv-cli": "11.0.0",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "semantic-release": "25.0.3",
    "tsdown": "0.22.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
